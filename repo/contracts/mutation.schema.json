{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "operation_id",
    "request_hash",
    "actor",
    "correlation_id",
    "schema_version",
    "scope",
    "expected_revision",
    "object"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "type": "string"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "object": {
      "type": "object"
    }
  }
}