{
  "openapi": "3.1.0",
  "info": {
    "title": "UACF State Service",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8766"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Actual service PID/epoch/source identity"
          }
        }
      }
    },
    "/v1/action": {
      "post": {
        "security": [
          {
            "localBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action",
                  "args"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object"
                  },
                  "operation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "actor": {
                    "enum": [
                      "owner",
                      "reader",
                      "dsh",
                      "pi",
                      "codex"
                    ]
                  },
                  "correlation_id": {
                    "type": "string"
                  },
                  "schema_version": {
                    "const": "1.0"
                  },
                  "scope": {
                    "type": "string"
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "request_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "description": "Mutations additionally require every identity/hash field; hash is canonical sorted UTF-8 JSON excluding request_hash. Per-action arguments in actions-batch2.schema.json."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action receipt; not necessarily verified or accepted"
          },
          "400": {
            "description": "Contract/limit/capability refusal"
          },
          "401": {
            "description": "Authentication"
          },
          "403": {
            "description": "Permission"
          },
          "404": {
            "description": "Not visible"
          },
          "409": {
            "description": "Revision/operation conflict"
          },
          "500": {
            "description": "Internal failure; no blind replay"
          }
        }
      }
    },
    "/e7": {
      "get": {
        "summary": "Existing browser-session authenticated source library view; data reads via /v1/action e7_library",
        "responses": {
          "200": {
            "description": "E7 library HTML (no credentials or source data embedded)"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "x-mutating-actions": [
    "action_contract_set",
    "archive_inventory",
    "archive_materialize",
    "archive_plan",
    "archive_read",
    "archive_reindex",
    "archive_run",
    "archive_trigger_check",
    "artifact_capture",
    "budget_open",
    "budget_reserve",
    "budget_settle",
    "capability_record",
    "coding_worker_audit",
    "coding_worker_bind",
    "coding_worker_configure",
    "coding_worker_fallback",
    "coding_worker_native_result",
    "coding_worker_prepare",
    "coding_worker_run",
    "command_update",
    "consistency_deliver",
    "consistency_prepare",
    "consistency_publish",
    "consistency_review",
    "correct",
    "exchange_export",
    "exchange_import",
    "guard_probe",
    "guard_reprepare",
    "host_event",
    "ingest",
    "integrate",
    "interpret",
    "learning_bind_host",
    "learning_checkpoint",
    "learning_configure",
    "learning_enable_use",
    "learning_enqueue",
    "learning_fallback",
    "learning_host_submit",
    "learning_mark",
    "learning_metadata",
    "learning_pause",
    "learning_probe",
    "learning_rebuild_use",
    "learning_recall",
    "learning_reconcile",
    "learning_register_guards",
    "learning_review",
    "learning_route",
    "learning_semantic_build",
    "learning_semantic_submit",
    "learning_start",
    "learning_verify",
    "lease_acquire",
    "lease_result",
    "model_dispatch",
    "native_watch_configure",
    "portable_draft",
    "portable_import",
    "portable_review",
    "portable_revise",
    "profile_set",
    "promote",
    "promote_host_project",
    "put",
    "reading_plan",
    "rebuild",
    "review_response",
    "source_register",
    "trial_reserve",
    "trial_settle",
    "verify_dsh",
    "verify_host_project",
    "work_enter",
    "work_mode",
    "work_policy_configure",
    "work_verify",
    "workflow_configure",
    "workflow_pause",
    "workflow_project_configure",
    "workflow_project_record",
    "workflow_resolve_rejection",
    "workflow_review_submit",
    "workflow_select_batch",
    "workflow_start",
    "workunit"
  ],
  "x-contract-version": "batch2-1",
  "x-e7-library": {
    "action": "e7_library",
    "mutation": false,
    "contract": "e7-semantic-1",
    "modes": [
      "summary",
      "body",
      "issues",
      "recall"
    ],
    "query_max_chars": 200,
    "data_access": "existing State actor ACL; body uses catalog source visibility",
    "semantics": "candidate; no automatic acceptance"
  }
}
